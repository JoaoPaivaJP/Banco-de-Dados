SELECT COUNT(*) AS total_produtos FROM produto;

SELECT id_produto, nome
FROM produto
ORDER BY id_produto DESC
LIMIT 3;

SELECT id_produto
FROM produto
WHERE preco > 1000
ORDER BY id_produto;

SELECT DISTINCT categoria
FROM produto
ORDER BY categoria;

SELECT id_produto
FROM produto
WHERE preco BETWEEN 80 AND 120
ORDER BY id_produto;

SELECT id_produto
FROM produto
WHERE nome LIKE 'Mouse%'
ORDER BY id_produto;

SELECT COUNT(*) AS sem_fornecedor
FROM produto
WHERE fornecedor IS NULL;

SELECT id_produto
FROM produto
WHERE categoria = 'Perifericos' AND estoque > 0
ORDER BY preco DESC, id_produto
LIMIT 2;

Select COUNT(*) AS total,
 COUNT(fornecedor) AS informados
FROM produto;

SELECT SUM(estoque) AS total_estoque
FROM produto
WHERE categoria = 'Acessorios';

SELECT MIN(preco) AS menor, MAX(preco) AS maior,
 ROUND(AVG(preco), 2) AS media
FROM produto
WHERE categoria = 'Armazenamento';

